{
  "expo": {
    "name": "Intus",
    "slug": "intus",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fit.intus.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Intus reads your sleep, heart rate variability and resting heart rate from Apple Health to show them in your log. It never writes to Apple Health. Only you can see this data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E5ECE9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fit.intus.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Intus reads your sleep, heart rate variability and resting heart rate from Apple Health to show them in your log. It never writes to Apple Health. Only you can see this data.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "intus"
  }
}
