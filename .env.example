# Both values are public by design (the publishable key is meant to ship in the browser; row-level security
# is what protects the data). They default to the production project, so a .env is only needed to point
# the app somewhere else.
VITE_SUPABASE_URL=https://zfyeqfnretrrmtevczrc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public web sign-in and account creation. Unset, or any value other than true, keeps them closed:
# the header and pricing page do not offer an account, and /signin, /login, /signup, /register and /auth/*
# redirect to /#waitlist. Set this to true in the Vercel project and redeploy to open them again.
# The same line in a local .env applies to `npm run dev` and `npm run preview`. Supabase settings stay as they are.
# VITE_WEB_AUTH_ENABLED=true
